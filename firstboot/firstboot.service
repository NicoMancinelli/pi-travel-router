[Unit]
Description=Travel Router first-boot setup wizard
# imager-compat.service must complete before we start: it neutralises
# firstrun.sh and writes the SSH key from Raspberry Pi Imager.  The
# Before= in imager-compat.service is not enough on its own when
# firstboot.service lives in multi-user.target — make the ordering
# explicit here too so systemd enforces it regardless of target changes.
#
# Use network.target (not network-online.target) to avoid a 90-120s
# delay on first boot when no uplink is configured yet.
After=network.target avahi-daemon.service imager-compat.service
Wants=imager-compat.service
RequiresMountsFor=/opt
ConditionPathExists=!/var/lib/travel-router/firstboot-done
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/lib/travel-router
ExecStart=/usr/bin/python3 /opt/pi-travel-router/firstboot/server.py
# NOTE: Do not add capability restrictions here — server.py spawns
# install.sh which needs full root capabilities (iptables, nftables,
# modprobe, chpasswd, systemctl, etc.).
Restart=on-failure
RestartSec=5
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
PrivateTmp=yes

[Install]
WantedBy=multi-user.target


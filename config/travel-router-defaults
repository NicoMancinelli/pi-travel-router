# Travel Router configuration
# Install to: /etc/default/travel-router
# Sourced by: router scripts and installer-managed services

# ntfy.sh push notifications
# 1. Pick a unique topic name (treated as a secret — don't share publicly)
# 2. Install ntfy app on iOS/Android: https://ntfy.sh
# 3. Subscribe to your topic in the app
# 4. Set NTFY_TOPIC below — notifications activate immediately
#
# NTFY_TOPIC="travel-router-yourname-2024"
NTFY_TOPIC=""

# iPhone Bluetooth MAC for Bluetooth PAN tethering.
# Pair first with bluetoothctl, then set the phone MAC here.
IPHONE_BT_MAC=""

# Tailscale restore arguments used after captive portal login.
TAILSCALE_UP_ARGS="--advertise-routes=10.3.141.0/24 --accept-dns=false"

# WAN probe targets tried in order by wan-watchdog.sh.
WAN_PING_TARGETS="1.1.1.1 8.8.8.8"

# Optional features.
ENABLE_OPEN_WIFI_FALLBACK="0"
ENABLE_DOT="0"
ENABLE_VPN_KILLSWITCH="0"
ENABLE_AUTO_UPDATES="0"
ENABLE_AVAHI_REFLECTOR="0"
# Carrier stealth (Visible/Verizon): reject QUIC (UDP 443) on uap0 to force TCP TLS 1.3.
# Defeats cellular video throttling and unencrypted UDP SNI fingerprinting; enables full BBR/CAKE stealth.
ENABLE_BLOCK_QUIC="1"

ENABLE_PER_DEVICE_VPN="0"
# Space-separated MAC addresses to route through Tailscale (all others go direct)
# Example: VPN_DEVICE_MACS="aa:bb:cc:dd:ee:ff 11:22:33:44:55:66"
VPN_DEVICE_MACS=""

# SSH public key for admin access. If set at install time, password auth is
# disabled and only this key is accepted. Set during install or add manually:
# echo '<pubkey>' >> ~/.ssh/authorized_keys
SSH_ADMIN_KEY=""

# Headscale URL — self-hosted Tailscale control server.
# Leave blank to use Tailscale cloud (login.tailscale.com).
# Example: HEADSCALE_URL="http://203.0.113.5:8080"
# Run scripts/setup-headscale.sh on your VPS to get this value.
HEADSCALE_URL=""

# CIDR-based split tunnel (#6): route specific destination subnets through the
# VPN uplink while everything else goes direct. Egress is Tailscale by default;
# set WG_SPLIT_TUNNEL_DEV=wg0 to use a WireGuard upstream peer instead.
# Enable with ENABLE_WG_SPLIT_TUNNEL=1, then list IPv4 CIDRs separated by spaces.
# Example: WG_SPLIT_TUNNEL_CIDRS="10.100.0.0/16 172.16.5.0/24 198.51.100.0/24"
ENABLE_WG_SPLIT_TUNNEL="0"
WG_SPLIT_TUNNEL_CIDRS=""
WG_SPLIT_TUNNEL_DEV="tailscale0"

# WAN metric auto-management: re-enforce uplink route metrics on each ifup.
ENABLE_WAN_METRICS="1"

# USB drive file sharing (travel NAS, #30).
# Shares /media/travel-data over SMB to AP clients (guest access — the AP
# passphrase is the gate; never exposed on uplink interfaces).
# Mount a drive first (mount-storage.sh), then enable.
# Clients connect to smb://10.3.141.1/<USB_SHARE_NAME>.
ENABLE_USB_SHARE="0"
USB_SHARE_NAME="TravelData"
USB_SHARE_RO="0"

# AP subnet and gateway IP.
AP_SUBNET="10.3.141.0/24"
AP_GATEWAY="10.3.141.1"

# WireGuard VPN
ENABLE_WIREGUARD=0
WG_LISTEN_PORT=51820
WG_NETWORK=10.9.0.0/24
WG_INTERFACE=wg0

# DNS-over-HTTPS resolver. Presets: cloudflare, quad9, nextdns, system.
# Set to 'system' to use DHCP-provided DNS (DoH disabled).
DOH_RESOLVER=system

# Local port for stubby DNS-over-TLS daemon (dnsmasq forwards to 127.0.0.1:DOT_PORT).
DOT_PORT=5300
